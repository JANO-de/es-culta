{
  "name": "es-culta",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/sync"] },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
