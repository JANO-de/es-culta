{
  "name": "es-culta",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/api/*", "/ws"] },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "HUB", "class_name": "Hub" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Hub"] }
  ],
  "observability": { "enabled": true }
}
